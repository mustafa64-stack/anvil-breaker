# Anvil Breaker™ Production Scaling Configuration (.env)

# Domain Configuration (Point your DNS CNAME or A record)
APP_DOMAIN=anvilbreaker.is-a.dev
PORT=8765
HOST=0.0.0.0

# Database Configuration (Defaults to high-concurrency SQLite in WAL mode)
# For managed PostgreSQL (Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/anvilbreaker
DATA_DIR=/app/data

# Security & Session Secrets
JWT_SECRET=anvil_prod_super_secret_key_change_me_in_production
CORS_ORIGINS=*

# Cloud / Server Mode
IS_CLOUD=true

